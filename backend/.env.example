# JWT Configuration
SECRET_KEY=replace_with_a_secure_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# API Gateway
GATEWAY_PORT=8000

# Authentication Service
AUTH_SERVICE_URL=http://127.0.0.1:8001
AUTH_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/support_auth_db

# Ticket Management Service
TICKET_SERVICE_URL=http://127.0.0.1:8002
TICKET_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/support_ticket_db

# Assignment Service
ASSIGNMENT_SERVICE_URL=http://127.0.0.1:8003
ASSIGNMENT_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/support_assignment_db

# Notification Service
NOTIFICATION_SERVICE_URL=http://127.0.0.1:8004
NOTIFICATION_DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@localhost:5432/support_notification_db

# Analytics Service
ANALYTICS_SERVICE_URL=http://127.0.0.1:8005

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# Frontend
FRONTEND_URL=http://localhost:5173